# Скопируйте в .env.local и заполните. Файл .env.local в git не попадает.

# Для приложения. Supabase Dashboard -> Project Settings -> API.
# В VITE_SUPABASE_ANON_KEY укажите anon или publishable ключ.
# Секретный ключ (service_role, sb_secret_) сюда указывать нельзя.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Только для npm run check:security. Без префикса VITE_, поэтому в сборку
# приложения не попадают. Это три пользователя, созданные в Dashboard.
CHECK_MANAGER_EMAIL=manager@example.com
CHECK_MANAGER_PASSWORD=
CHECK_EXECUTOR_A_EMAIL=executor.a@example.com
CHECK_EXECUTOR_A_PASSWORD=
CHECK_EXECUTOR_B_EMAIL=executor.b@example.com
CHECK_EXECUTOR_B_PASSWORD=
